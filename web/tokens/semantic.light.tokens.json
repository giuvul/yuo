    "logo-inverse": {
      "$type": "color",
      "$value": "{color.neutral.100}",
      "$description": "the logo on a Forest surface (the app icon's treatment)"
    },
    "logo-inverse-leaf": {
      "$type": "color",
      "$value": "{color.green.600}",
      "$description": "the right leaf of the logo on a Forest surface"
    },
    "media-bg": {
      "$type": "color",
      "$value": "{color.green.800}",
      "$description": "behind a lesson video and its poster"
    },
    "media-bar": {
      "$type": "color",
      "$value": "{color.green.900}",
      "$description": "the video control bar"
    },
    "media-fg": {
      "$type": "color",
      "$value": "{color.neutral.100}",
      "$description": "controls and text on the video bar"
    },
    "scrim": {
      "$type": "color",
      "$value": "{color.green.950}",
      "$description": "behind a modal dialog (used with transparency)"
    },
    "pattern-leaf": {
      "$type": "color",
      "$value": "{color.green.200}",
      "$description": "decorative only: the botanical leaf pattern behind the page (never behind text alone)"
    },
    "mote": {
      "$type": "color",
      "$value": "{color.pollen.400}",
      "$description": "decorative only: pollen motes, shown at low opacity"
    },
    "illus-deep": {
      "$type": "color",
      "$value": "{color.green.800}",
      "$description": "illustrations and the skill tree only"
    },
    "illus-mid": {
      "$type": "color",
      "$value": "{color.green.600}",
      "$description": "illustrations and the skill tree only"
    },
    "illus-soft": {
      "$type": "color",
      "$value": "{color.green.300}",
      "$description": "illustrations and the skill tree only"
    },
    "illus-ground": {
      "$type": "color",
      "$value": "{color.green.200}",
      "$description": "illustrations and the skill tree only"
    },
    "illus-paper": {
      "$type": "color",
      "$value": "{color.neutral.100}",
      "$description": "illustrations and the skill tree only"
    },
    "illus-sun": {
      "$type": "color",
      "$value": "{color.pollen.300}",
      "$description": "illustrations only: the Pollen sun"
    },
    "illus-clay": {
      "$type": "color",
      "$value": "{color.clay.500}",
      "$description": "illustrations only: a small Clay accent"
    },
    "illus-bark": {
      "$type": "color",
      "$value": "{color.bark}",
      "$description": "illustrations only: trunks and details"
    },
    "twig": {
      "$type": "color",
      "$value": "{color.neutral.600}",
      "$description": "a dormant branch, a locked node's outline, prerequisite tendrils (3:1 on the page)"
    }
