{
  "$description": "Yuo semantic colours, light theme. Components use only these (as --yuo-color-<name>).",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{color.neutral.50}",
      "$description": "page background"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "cards and panels"
    },
    "surface-muted": {
      "$type": "color",
      "$value": "{color.neutral.100}",
      "$description": "quiet panels inside a page (estimate, tutor)"
    },
    "border": {
      "$type": "color",
      "$value": "{color.neutral.200}",
      "$description": "hairlines"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{color.neutral.400}",
      "$description": "input and control borders"
    },
    "fg": {
      "$type": "color",
      "$value": "{color.green.800}",
      "$description": "text"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.700}",
      "$description": "secondary text"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.green.800}",
      "$description": "primary action background"
    },
    "accent-fg": {
      "$type": "color",
      "$value": "{color.neutral.100}",
