    "link": {
      "$type": "color",
      "$value": "{color.green.700}",
      "$description": "links"
    },
    "focus": {
      "$type": "color",
      "$value": "{color.green.600}",
      "$description": "focus ring"
    },
    "highlight": {
      "$type": "color",
      "$value": "{color.pollen.300}",
      "$description": "progress, the current lesson (pollen)"
    },
    "highlight-fg": {
      "$type": "color",
      "$value": "{color.green.900}",
      "$description": "text on highlight"
    },
    "success": {
      "$type": "color",
      "$value": "{color.green.700}",
      "$description": "success text"
    },
    "success-bg": {
      "$type": "color",
      "$value": "{color.green.100}",
      "$description": "success background"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.pollen.700}",
      "$description": "warning text"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "{color.pollen.100}",
      "$description": "warning background"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.clay.700}",
      "$description": "error text"
    },
    "danger-bg": {
      "$type": "color",
      "$value": "{color.clay.100}",
      "$description": "error background"
    },
    "info-bg": {
      "$type": "color",
      "$value": "{color.green.50}",
      "$description": "information background"
    },
    "code-bg": {
      "$type": "color",
      "$value": "{color.neutral.100}",
      "$description": "code background"
    },
    "track": {
      "$type": "color",
      "$value": "{color.neutral.200}",
      "$description": "progress track"
    },
    "leaf": {
      "$type": "color",
      "$value": "{color.green.600}",
      "$description": "leaf and branch drawings"
    },
    "logo-leaf": {
      "$type": "color",
      "$value": "{color.green.600}",
      "$description": "the logo's right leaf: Moss on light, one-colour Mist on dark"
